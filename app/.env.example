# Required for AI SDK calls to OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# App-level model defaults.
OPENAI_MODEL=gpt-5-mini
OPENAI_HEAVY_MODEL=gpt-5.4

# Persistent server data directory. Docker Compose mounts a named volume here.
APP_DATA_DIR=/app/data

# Canonical browser origin, without a trailing slash or path.
APP_ORIGIN=http://localhost:3000
BASE_PATH=/

# Triggers automatic legacy migration before the Docker server listens. Never assigns request owners.
LEGACY_USER_EMAIL=legacy@example.com

# Optional local backup destination. Compose sets this to its backup volume.
# MIGRATION_BACKUP_DIR=/absolute/path/to/backups
